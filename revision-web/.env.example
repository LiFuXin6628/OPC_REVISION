# File mau. Sao chep thanh .env.local de chay tren may.
# Vercel can khai bao cac gia tri trong Settings > Environment Variables.
# Sau khi sua bien tren Vercel, Redeploy de ap dung.

# Bat buoc cho dang nhap. Dien tai khoan rieng cua ban.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Toi thieu 32 byte. Tao bang lenh duoc huong dan trong README.md.
JWT_SECRET=

# Tren may co the dung sqlite. Tren Vercel dung google-sheets.
SUBMISSION_STORAGE=google-sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
